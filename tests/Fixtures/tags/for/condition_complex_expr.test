--TEST--
"for" tag condition accepts any expression: boolean ops, tests, function calls
--TEMPLATE--
{% for user in users if user.active and user.age >= 18 and user.name|length > 1 -%}
{{ user.name }}
{% endfor %}
--DATA--
return ['users' => [
    ['name' => 'Al',    'age' => 30, 'active' => true],
    ['name' => 'B',     'age' => 25, 'active' => true],
    ['name' => 'Carol', 'age' => 16, 'active' => true],
    ['name' => 'Dave',  'age' => 40, 'active' => false],
    ['name' => 'Eve',   'age' => 22, 'active' => true],
]]
--EXPECT--
Al
Eve
